# Plantilla de variables de entorno. Copia este archivo como .env
# y rellena los valores reales:  cp .env.example .env
DB_URL=jdbc:mysql://localhost:3306/api_rest_spring-boot
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_password
# Puerto del servidor HTTP (opcional; si no está, la app usa 8080)
SERVER_PORT=8080
